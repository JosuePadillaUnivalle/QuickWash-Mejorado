@startuml
left to right direction
skinparam backgroundColor white
skinparam shadowing false
skinparam usecaseBorderColor #A42643
skinparam usecaseBackgroundColor #FCF5F7
actor Estudiante as E
actor "Personal de lavandería" as P
rectangle "QuickWash Campus · V1 Mejorado" {
usecase "CU-01\nRegistrar estudiante" as U1
usecase "CU-02\nIniciar sesión" as U2
usecase "CU-03\nConsultar disponibilidad" as U3
usecase "CU-04\nRegistrar reserva" as U4
usecase "CU-05\nConsultar mis reservas" as U5
usecase "CU-06\nCancelar reserva" as U6
usecase "CU-07\nConsultar todas las reservas" as U7
usecase "CU-08\nCambiar estado" as U8
usecase "CU-09\nCerrar sesión" as U9
usecase "CU-10\nCrear lavadora" as U10
usecase "CU-11\nEditar lavadora" as U11
usecase "CU-12\nEliminar lavadora" as U12
}
E -- U1
E -- U2
E -- U3
E -- U4
E -- U5
E -- U6
E -- U9
P -- U2
P -- U7
P -- U8
P -- U9
P -- U10
P -- U11
P -- U12
U4 ..> U3 : <<include>>
U6 ..> U5 : <<extend>>
U8 ..> U7 : <<extend>>
note bottom of U6
Propia, Pendiente y antes del inicio.
end note
@enduml
